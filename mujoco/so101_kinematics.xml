<?xml version="1.0" encoding="utf-8"?>
<mujoco model="workbench_xlerobot_dual_arm">
  <compiler angle="radian" autolimits="true" />
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast" />
  <default>
    <joint damping="0.5" armature="0.05" frictionloss="0.01" />
    <geom condim="6" friction="1 0.5 0.5" />
    <position kp="200" dampratio="0.7" forcerange="-100 100" ctrlrange="-3.14158 3.14158" />
  </default>
  <asset>
    <!-- 材质 -->
    <material name="table_top" rgba="0.7 0.7 0.75 1" specular="0.2" shininess="0.1" />
    <material name="table_leg" rgba="0.3 0.3 0.35 1" specular="0.3" shininess="0.2" />
    <material name="floor" rgba="0.15 0.15 0.2 1" specular="0.1" shininess="0.1" />
    <material name="target" rgba="1 0 0 0.8" />
    <material name="black" rgba="0.3 0.3 0.3 1" specular="0.1" shininess="0.1" />
    <material name="base_left" rgba="0.1 0.4 0.7 1" specular="0.3" shininess="0.3" />
    <material name="base_right" rgba="0.7 0.2 0.2 1" specular="0.3" shininess="0.3" />
    <!-- XLeRobot 机械臂 STL 模型 -->
  </asset>
  <worldbody>
    <!-- 灯光 -->
    <light name="spotlight" pos="0 0 2.5" dir="0 0 -1" directional="true" />
    <!-- 地面 -->
    <geom name="floor" type="plane" size="3 3 0.1" material="floor" contype="1" conaffinity="1" />
    <!-- 工作台 -->
    <body name="workbench" pos="0 0 0.05">
      <!-- 桌面：1.2m x 1.2m 正方形 -->
      <geom name="tabletop" type="box" size="0.6 0.6 0.025" material="table_top" contype="1" conaffinity="1" />
      <!-- 四根桌腿 -->
      <geom name="leg_fl" type="cylinder" size="0.025 0.05" pos="-0.5 -0.5 0" material="table_leg" />
      <geom name="leg_fr" type="cylinder" size="0.025 0.05" pos="0.5 -0.5 0" material="table_leg" />
      <geom name="leg_bl" type="cylinder" size="0.025 0.05" pos="-0.5 0.5 0" material="table_leg" />
      <geom name="leg_br" type="cylinder" size="0.025 0.05" pos="0.5 0.5 0" material="table_leg" />
      <!-- 左机械臂（XLeRobot 模型，完全照搬原始结构） -->
      <body name="robot1_base" pos="-0.5 0 0.05">
        <!-- 基座 -->
        <geom type="cylinder" size="0.1 0.05" material="base_left" />
        <body name="robot1_mount" pos="0 0 0.05">
          <geom type="cylinder" size="0.08 0.03" material="base_left" />
          <!-- J1: Rotation (axis: 0 -1 0) - 原始 XLeRobot 配置 -->
          <body name="robot1_rotation" pos="0 0 0.03" quat="0.499998 0.5 0.500002 0.5">
            <inertial pos="-9.07886e-05 0.0590972 0.031089" quat="0.363978 0.441169 -0.623108 0.533504" mass="0.119226" diaginertia="5.94278e-05 5.89975e-05 3.13712e-05" />
            <joint name="robot1_j1" pos="0 0 0" axis="0 -1 0" range="-2.1 2.1" damping="0.1" armature="0.01" frictionloss="0.001" />
            <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
            <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
            <!-- J2: Pitch (axis: -1 0 0) -->
            <body name="robot1_pitch" pos="0 0.1025 0.0306" quat="0.707105 0.707108 0 0">
              <inertial pos="-1.72052e-05 0.0701802 0.00310545" quat="0.50104 0.498994 -0.493562 0.50632" mass="0.162409" diaginertia="0.000213312 0.000167164 7.01522e-05" />
              <joint name="robot1_j2" pos="0 0 0" axis="-1 0 0" range="-0.1 3.45" />
              <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
              <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
              <!-- J3: Elbow (axis: 1 0 0) -->
              <body name="robot1_elbow" pos="0 0.11257 0.028" quat="0.707105 -0.707108 0 0">
                <inertial pos="-0.00339604 0.00137796 0.0768007" quat="0.701995 0.0787996 0.0645626 0.704859" mass="0.147968" diaginertia="0.000138803 0.000107748 4.84242e-05" />
                <joint name="robot1_j3" pos="0 0 0" axis="1 0 0" range="-0.2 3.14159" />
                <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                <!-- J4: Wrist_Pitch (axis: 1 0 0) -->
                <body name="robot1_wrist_pitch" pos="0 0.0052 0.1349" quat="0.707105 -0.707108 0 0">
                  <inertial pos="-0.00852653 -0.0352279 -2.34622e-05" quat="-0.0522806 0.705235 0.0549524 0.704905" mass="0.0661321" diaginertia="3.45403e-05 2.39041e-05 1.94704e-05" />
                  <joint name="robot1_j4" pos="0 0 0" axis="1 0 0" range="-1.8 1.8" />
                  <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                  <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                  <!-- J5: Wrist_Roll (axis: 0 -1 0) - Fixed_Jaw 结构 -->
                  <body name="robot1_fixed_jaw" pos="0 -0.0601 0" quat="0.707105 0 0.707108 0">
                    <inertial pos="0.00552377 -0.0280167 0.000483583" quat="0.41836 0.620891 -0.350644 0.562599" mass="0.0929859" diaginertia="5.03136e-05 4.64098e-05 2.72961e-05" />
                    <joint name="robot1_j5" pos="0 0 0" axis="0 -1 0" range="-3.14159 3.14159" />
                    <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                    <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                    <!-- J6: Jaw (axis: 0 0 1) - Moving_Jaw -->
                    <body name="robot1_gripper" pos="-0.0202 -0.0244 0" quat="3.45518e-07 -0.0940644 0.995566 -3.65692e-06">
                      <inertial pos="-0.00161745 -0.0303473 0.000449646" quat="0.696562 0.716737 -0.0239844 -0.0227026" mass="0.0202444" diaginertia="1.11265e-05 8.99651e-06 2.99548e-06" />
                      <joint name="robot1_j6" pos="0 0 0" axis="0 0 1" range="0 1" />
                      <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                      <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                      <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <!-- 右机械臂（XLeRobot 模型，旋转 180 度朝向左臂） -->
      <body name="robot2_base" pos="0.5 0 0.05">
        <!-- 基座 -->
        <geom type="cylinder" size="0.1 0.05" material="base_right" />
        <body name="robot2_mount" pos="0 0 0.05">
          <geom type="cylinder" size="0.08 0.03" material="base_right" />
          <!-- J1: Rotation (axis: 0 1 0) - 绕 Z 轴旋转，但与robot1相反 -->
          <body name="robot2_rotation" pos="0 0 0.03" quat="0.5 0.5 -0.5 -0.5">
            <inertial pos="-9.07886e-05 0.0590972 0.031089" quat="0.363978 0.441169 -0.623108 0.533504" mass="0.119226" diaginertia="5.94278e-05 5.89975e-05 3.13712e-05" />
            <joint name="robot2_j1" pos="0 0 0" axis="0 -1 0" range="-2.1 2.1" damping="0.1" armature="0.01" frictionloss="0.001" />
            <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
            <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
            <!-- J2: Pitch (axis: -1 0 0) - 与左臂完全相同 -->
            <body name="robot2_pitch" pos="0 0.1025 0.0306" quat="0.707105 0.707108 0 0">
              <inertial pos="-1.72052e-05 0.0701802 0.00310545" quat="0.50104 0.498994 -0.493562 0.50632" mass="0.162409" diaginertia="0.000213312 0.000167164 7.01522e-05" />
              <joint name="robot2_j2" pos="0 0 0" axis="-1 0 0" range="-0.1 3.45" />
              <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
              <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
              <!-- J3: Elbow (axis: 1 0 0) - 与左臂完全相同 -->
              <body name="robot2_elbow" pos="0 0.11257 0.028" quat="0.707105 -0.707108 0 0">
                <inertial pos="-0.00339604 0.00137796 0.0768007" quat="0.701995 0.0787996 0.0645626 0.704859" mass="0.147968" diaginertia="0.000138803 0.000107748 4.84242e-05" />
                <joint name="robot2_j3" pos="0 0 0" axis="1 0 0" range="-0.2 3.14159" />
                <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                <!-- J4: Wrist_Pitch (axis: 1 0 0) - 与左臂完全相同 -->
                <body name="robot2_wrist_pitch" pos="0 0.0052 0.1349" quat="0.707105 -0.707108 0 0">
                  <inertial pos="-0.00852653 -0.0352279 -2.34622e-05" quat="-0.0522806 0.705235 0.0549524 0.704905" mass="0.0661321" diaginertia="3.45403e-05 2.39041e-05 1.94704e-05" />
                  <joint name="robot2_j4" pos="0 0 0" axis="1 0 0" range="-1.8 1.8" />
                  <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                  <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                  <!-- J5: Wrist_Roll (axis: 0 -1 0) - Fixed_Jaw 结构 -->
                  <body name="robot2_fixed_jaw" pos="0 -0.0601 0" quat="0.707105 0 0.707108 0">
                    <inertial pos="0.00552377 -0.0280167 0.000483583" quat="0.41836 0.620891 -0.350644 0.562599" mass="0.0929859" diaginertia="5.03136e-05 4.64098e-05 2.72961e-05" />
                    <joint name="robot2_j5" pos="0 0 0" axis="0 -1 0" range="-3.14159 3.14159" />
                    <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                    <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                    <!-- J6: Jaw (axis: 0 0 1) - Moving_Jaw -->
                    <body name="robot2_gripper" pos="-0.0202 -0.0244 0" quat="3.45518e-07 -0.0940644 0.995566 -3.65692e-06">
                      <inertial pos="-0.00161745 -0.0303473 0.000449646" quat="0.696562 0.716737 -0.0239844 -0.0227026" mass="0.0202444" diaginertia="1.11265e-05 8.99651e-06 2.99548e-06" />
                      <joint name="robot2_j6" pos="0 0 0" axis="0 0 1" range="0 1" />
                      <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                      <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                      <geom type="sphere" material="black" size="0.01" contype="0" conaffinity="0" />
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <!-- 中心标记点 -->
      <site name="center" pos="0 0 0.076" size="0.02" material="target" />
    </body>
    <!-- 多机位相机：真实机械臂模型的素材采集和训练渲染 -->
    <camera name="top" pos="0 0 2.35" xyaxes="1 0 0 0 1 0" fovy="42" />
    <camera name="front" pos="0 -1.8 1.2" xyaxes="1 0 0 0 0.339644 0.940554" fovy="45" />
    <camera name="side" pos="1.8 0 1.2" xyaxes="0 1 0 -0.339644 0 0.940554" fovy="45" />
    <camera name="left_oblique" pos="-1.4 -1.3 1.3" xyaxes="0.680451 -0.732793 0 0.267777 0.24865 0.930843" fovy="42" />
    <camera name="right_oblique" pos="1.4 -1.3 1.3" xyaxes="0.680451 0.732793 0 -0.267777 0.24865 0.930843" fovy="42" />
    <camera name="assembly" pos="0 -1 0.9" xyaxes="1 0 0 0 0.33035 0.943858" fovy="34" />
    <camera name="closeup" pos="0 -0.75 1.05" xyaxes="1 0 0 0 0.682318 0.731055" fovy="26" />
  </worldbody>
  <actuator>
    <!-- 左机械臂执行器 -->
    <position name="robot1_a1" joint="robot1_j1" kp="50000" dampratio="0.4" forcerange="-50000 50000" ctrlrange="-2.1 2.1" />
    <position name="robot1_a2" joint="robot1_j2" ctrlrange="-0.1 3.45" />
    <position name="robot1_a3" joint="robot1_j3" ctrlrange="-0.2 3.14159" />
    <position name="robot1_a4" joint="robot1_j4" ctrlrange="-1.8 1.8" />
    <position name="robot1_a5" joint="robot1_j5" ctrlrange="-3.14159 3.14159" />
    <position name="robot1_a6" joint="robot1_j6" ctrlrange="0 1" />
    <!-- 右机械臂执行器 -->
    <position name="robot2_a1" joint="robot2_j1" kp="50000" dampratio="0.4" forcerange="-50000 50000" ctrlrange="-2.1 2.1" />
    <position name="robot2_a2" joint="robot2_j2" ctrlrange="-0.1 3.45" />
    <position name="robot2_a3" joint="robot2_j3" ctrlrange="-0.2 3.14159" />
    <position name="robot2_a4" joint="robot2_j4" ctrlrange="-1.8 1.8" />
    <position name="robot2_a5" joint="robot2_j5" ctrlrange="-3.14159 3.14159" />
    <position name="robot2_a6" joint="robot2_j6" ctrlrange="0 1" />
  </actuator>
  <statistic center="0 0 0.8" extent="2" />
  <visual>
    <global offwidth="1280" offheight="720" />
  </visual>
</mujoco>